# AdapterPay — modelo do .env de PRODUÇÃO da VPS (sem segredos reais).
# Copie para .env, troque todos os CHANGE_ME e deixe com permissão 600 (chmod 600 .env).
# Nunca versionar o .env real.

# ---------------------------------------------------------------- aplicação
NODE_ENV=production
APP_URL=https://adapterpay.adapterco.com.br
API_PUBLIC_URL=https://adapterpay.adapterco.com.br/api/v1
TZ=UTC

# ---------------------------------------------------------------- banco e fila (serviços internos do compose)
# Host "postgres" e "redis" = nomes dos serviços no docker-compose.prod.yml (rede interna isolada).
# A senha da DATABASE_URL deve ser a MESMA de POSTGRES_PASSWORD.
DATABASE_URL=postgresql://adapterpay:CHANGE_ME@postgres:5432/adapterpay
REDIS_URL=redis://redis:6379

POSTGRES_USER=adapterpay
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=adapterpay

# ---------------------------------------------------------------- segredos
# openssl rand -base64 48
SESSION_SECRET=CHANGE_ME
# openssl rand -base64 32  (32 bytes; AES-256-GCM para tokens MP, segredo MFA e CPF/CNPJ)
ENCRYPTION_KEY=CHANGE_ME
ENCRYPTION_KEY_ID=k1
# Chaves anteriores para rotação, formato id:base64,id:base64 (somente decifragem).
ENCRYPTION_PREVIOUS_KEYS=

# ---------------------------------------------------------------- Mercado Pago
# App OAuth da Adapter Co. (credenciais de produção). Cadastre a Redirect URI abaixo, exatamente igual, no app MP.
MP_CLIENT_ID=CHANGE_ME
MP_CLIENT_SECRET=CHANGE_ME
MP_OAUTH_REDIRECT_URI=https://adapterpay.adapterco.com.br/api/v1/integrations/mercado-pago/callback
# true somente se o PKCE estiver habilitado no app Mercado Pago.
MP_OAUTH_PKCE=false
# Access Token de PRODUÇÃO da conta Mercado Pago da Adapter Co. (cobra a mensalidade dos planos).
# Os tokens dos LOJISTAS não vão aqui: vêm pelo botão "Conectar Mercado Pago" (OAuth) e ficam cifrados no banco.
MP_PLATFORM_ACCESS_TOKEN=CHANGE_ME
POLL_INTERVAL_SECONDS=3
CHARGE_EXPIRATION_SECONDS=180

# ---------------------------------------------------------------- assinaturas
# Fuso usado para EXIBIR vencimentos. O instante de vencimento é sempre armazenado em UTC.
BILLING_DISPLAY_TIMEZONE=America/Sao_Paulo
# Dias antes do fim do período em que a fatura Pix de renovação é emitida.
BILLING_RENEWAL_LEAD_DAYS=5

# ---------------------------------------------------------------- email (OPCIONAL)
# Só usado na recuperação de senha. Sem SMTP, deixe em branco: o administrador redefine a senha em Usuários.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="AdapterPay <nao-responda@adapterco.com.br>"

# ---------------------------------------------------------------- WhatsApp (Evolution API)
# Fechamento de caixa diário enviado ao dono da loja. Sem as três variáveis, o envio fica desligado.
EVOLUTION_API_URL=https://evolution.adapterco.com.br
EVOLUTION_INSTANCE=adapterpay
EVOLUTION_API_KEY=CHANGE_ME

# ---------------------------------------------------------------- observabilidade
# OpenAPI/Swagger protegido por HTTP Basic. Se vazio, a documentação não é publicada.
SWAGGER_USER=
SWAGGER_PASSWORD=
# Token bearer para /api/v1/metrics (Prometheus). Se vazio, o endpoint responde 404.
METRICS_TOKEN=

# ---------------------------------------------------------------- Traefik do EasyPanel (já existente na VPS)
# Valores conferidos nas labels do ordemcerta: rede traefik9, entrypoints http/https, resolver letsencrypt.
TRAEFIK_NETWORK=traefik9
TRAEFIK_ENTRYPOINT=https
TRAEFIK_HTTP_ENTRYPOINT=http
TRAEFIK_CERT_RESOLVER=letsencrypt
APP_HOST=adapterpay.adapterco.com.br
# Proxy confiável para X-Forwarded-*: use a sub-rede da traefik9, obtida com
#   docker network inspect traefik9 --format '{{range .IPAM.Config}}{{.Subnet}}{{end}}'
# "uniquelocal" (10/8, 172.16/12, 192.168/16) funciona, mas a sub-rede exata é mais restritiva.
TRUSTED_PROXIES=uniquelocal

# ---------------------------------------------------------------- backups
# OPCIONAL. Destinatário GPG (email/fingerprint de chave pública importada na VPS) para criptografar backups.
# Em branco: backups sem criptografia, com permissão 600.
BACKUP_GPG_RECIPIENT=
