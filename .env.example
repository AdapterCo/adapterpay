# AdapterPay — exemplo de variáveis de ambiente (sem segredos reais).
# Em produção use o mecanismo protegido de deploy (arquivo .env fora do repositório com permissão 600
# ou Docker secrets). Nunca versionar .env real.

NODE_ENV=production
APP_URL=https://adapterpay.adapterco.com.br
API_PUBLIC_URL=https://adapterpay.adapterco.com.br/api/v1
DATABASE_URL=postgresql://adapterpay:CHANGE_ME@postgres:5432/adapterpay
REDIS_URL=redis://redis:6379
SESSION_SECRET=CHANGE_ME
# 32 bytes em base64 (openssl rand -base64 32). Usada em AES-256-GCM para tokens MP, segredos MFA e tax_id.
ENCRYPTION_KEY=CHANGE_ME
ENCRYPTION_KEY_ID=k1
# Chaves anteriores para rotação, formato id:base64,id:base64 (somente decifragem).
ENCRYPTION_PREVIOUS_KEYS=
MP_CLIENT_ID=CHANGE_ME
MP_CLIENT_SECRET=CHANGE_ME
MP_OAUTH_REDIRECT_URI=https://adapterpay.adapterco.com.br/api/v1/integrations/mercado-pago/callback
# Referência às credenciais da conta Mercado Pago da PLATAFORMA (assinaturas Adapter Co).
# Formatos aceitos: file:/run/secrets/mp_platform_access_token  ou  env:MP_PLATFORM_ACCESS_TOKEN
MP_PLATFORM_CREDENTIALS_REF=CHANGE_ME
POLL_INTERVAL_SECONDS=3
CHARGE_EXPIRATION_SECONDS=180
TZ=UTC

# Fuso usado para EXIBIR vencimentos. O instante de vencimento é sempre armazenado em UTC.
BILLING_DISPLAY_TIMEZONE=America/Sao_Paulo
# Dias antes do fim do período em que a fatura Pix de renovação é emitida.
BILLING_RENEWAL_LEAD_DAYS=5

# Email transacional (verificação, recuperação de senha, convites). Obrigatório em produção.
SMTP_HOST=CHANGE_ME
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=CHANGE_ME
SMTP_PASSWORD=CHANGE_ME
SMTP_FROM="AdapterPay <nao-responda@adapterco.com.br>"

# OpenAPI/Swagger protegido por HTTP Basic. Se vazio, a documentação não é publicada.
SWAGGER_USER=
SWAGGER_PASSWORD=
# Token bearer para /api/v1/metrics (Prometheus). Se vazio, o endpoint responde 404.
METRICS_TOKEN=

# Traefik existente na VPS — inspecione a VPS antes de preencher (docker network ls, labels do Traefik).
TRAEFIK_NETWORK=traefik
TRAEFIK_ENTRYPOINT=https
TRAEFIK_CERT_RESOLVER=letsencrypt
APP_HOST=adapterpay.adapterco.com.br

# Postgres do compose de produção
POSTGRES_USER=adapterpay
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=adapterpay
# Destinatário GPG para criptografar backups
BACKUP_GPG_RECIPIENT=CHANGE_ME
